local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local autoBulb = true
local loopRunning = false

-- 兼容没有writefile的执行器，不会报错
local function canUseFile()
    return type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
end

local function getRoot()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function loadSavedPosition()
    if canUseFile() and isfile("BulbCollectorGuiPos.json") then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile("BulbCollectorGuiPos.json"))
        end)
        if ok and data and data.XScale then
            return UDim2.new(data.XScale, data.XOffset, data.YScale, data.YOffset)
        end
    end
    -- 没有getgenv就跳过，不崩溃
    if type(getgenv)=="function" and getgenv().BulbCollectorLastPos then
        return getgenv().BulbCollectorLastPos
    end
    return UDim2.new(0.5, -60, 0.3, -25)
end

local function savePosition(pos)
    if type(getgenv)=="function" then
        getgenv().BulbCollectorLastPos = pos
    end
    if not canUseFile() then return end
    local ok, encoded = pcall(function()
        return HttpService:JSONEncode({
            XScale = pos.X.Scale,
            XOffset = pos.X.Offset,
            YScale = pos.Y.Scale,
            YOffset = pos.Y.Offset,
        })
    end)
    if ok then
        pcall(function()
            writefile("BulbCollectorGuiPos.json", encoded)
        end)
    end
end

-- 糖果抓取循环
local function collectLoop()
    if loopRunning then return end
    loopRunning = true

    task.spawn(function()
        while autoBulb do
            task.wait()
            local root = getRoot()
            if not root then break end
            local rootPos = root.Position
            for _, inst in ipairs(workspace:GetDescendants()) do
                if inst:IsA("BasePart") and inst.Name == "Candy Part" then
                    inst.CFrame = CFrame.new(rootPos)
                end
            end
        end
        loopRunning = false
    end)
end

local function createUI()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    local gui = Instance.new("ScreenGui")
    gui.Name = "BulbCollectorGui"
    gui.ResetOnSpawn = false
    gui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Name = "MainFrame"
    frame.Size = UDim2.new(0, 120, 0, 60)
    frame.Position = loadSavedPosition()
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local dragArea = Instance.new("Frame")
    dragArea.Name = "DragArea"
    dragArea.Size = UDim2.new(1, 0, 0, 18)
    dragArea.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    dragArea.BackgroundTransparency = 0.2
    dragArea.Active = true
    dragArea.Parent = frame

    local dragCorner = Instance.new("UICorner")
    dragCorner.CornerRadius = UDim.new(0, 6)
    dragCorner.Parent = dragArea

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -30, 1, 0)
    title.Position = UDim2.new(0, 5, 0, 0)
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 10
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Text = "糖果拾取"
    title.Parent = dragArea

    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.new(0, 18, 0, 18)
    closeButton.Position = UDim2.new(1, -20, 0, 0)
    closeButton.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    closeButton.TextColor3 = Color3.new(1, 1, 1)
    closeButton.Text = "X"
    closeButton.Font = Enum.Font.GothamBold
    closeButton.TextSize = 12
    closeButton.Parent = dragArea

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(1, 0)
    closeCorner.Parent = closeButton

    local button = Instance.new("TextButton")
    button.Name = "ToggleButton"
    button.Size = UDim2.new(1, -20, 0, 30)
    button.Position = UDim2.new(0, 10, 0, 22)
    button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Text = "拾取糖果"
    button.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = button

    local dragging = false
    local dragStart
    local startPos

    local function update(input)
        local delta = input.Position - dragStart
        local newPos = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
        frame.Position = newPos
    end

    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    savePosition(frame.Position)
                end)
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)

    closeButton.MouseButton1Click:Connect(function()
        gui:Destroy()
        autoBulb = false
    end)

    button.MouseButton1Click:Connect(function()
        autoBulb = not autoBulb
        if autoBulb then
            button.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            button.Text = "拾取糖果"
            collectLoop()
        else
            button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            button.Text = "拾取糖果"
        end
    end)

    return gui, frame, button
end

local gui, frame, button = createUI()
collectLoop()
